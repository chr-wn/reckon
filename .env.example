# ── Database ────────────────────────────────────────────────────────────────
# Local development needs nothing: without DATABASE_URL the app uses an embedded
# Postgres (PGlite) stored in ./.data/pglite.
#
# Production: set DATABASE_URL in Vercel to Supabase's *Transaction pooler*
# string (Connect → Connection string → Transaction pooler, port 6543), with your
# database password filled in (URL-encode it if it contains @ : / # ?).
# To migrate from your laptop, put it in .env.production.local (not .env.local)
# and run `npm run db:migrate:prod`.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Google sign-in ──────────────────────────────────────────────────────────
# From a Google Cloud "OAuth client ID" (type: Web application). Authorized
# redirect URIs must include https://<your-domain>/auth/google/callback
# (and http://localhost:3000/auth/google/callback to use Google locally —
# locally you can also just use the dev-login buttons on /login).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Signups ─────────────────────────────────────────────────────────────────
# Optional. If set, a new account's first Google sign-in needs this code.
# Returning users never need it.
# SIGNUP_CODE=pick-something
